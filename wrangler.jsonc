{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creative-creators-studio",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/files/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "APP_NAME": "Creative Creators Studio",
    "APP_URL": "http://localhost:5173",
    "MAIL_FROM": "Creative Creators <studio@example.com>",
    "ADMIN_EMAILS": "cameron@clearskycreations.com",
    "CREDIT_USD": "0.001",
    "CREDIT_MARKUP": "1",
    "DEFAULT_CREDIT_LIMIT": "25000",
    "SESSION_DAYS": "30",
    "GOOGLE_ALLOWED_DOMAINS": "clearskycreations.com",
    "CONFIRM_OVER_USD": "0.50",
    "NOTION_RESEARCH_SOURCE": "318a696c-1a53-8060-a02f-000bd0339281",
    "NOTION_RESEARCH_DB": "318a696c1a5380ab9a2bc514630ee9a7"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "studio-db", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "studio-files" }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "studio-jobs" }],
    "consumers": [{ "queue": "studio-jobs", "max_batch_size": 5, "max_retries": 8, "max_batch_timeout": 5 }]
  },
  "triggers": { "crons": ["*/2 * * * *"] }
}
